FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS go-builder

ARG TARGETARCH

RUN dpkg --add-architecture ${TARGETARCH} && apt-get update && apt-get install -y \
    gcc-aarch64-linux-gnu \
    libusb-1.0-0-dev:${TARGETARCH} \
    libftdi1-dev:${TARGETARCH} \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN case "${TARGETARCH}" in \
    arm64) \
        PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
        CGO_ENABLED=1 GOOS=linux GOARCH=arm64 CC=aarch64-linux-gnu-gcc \
        go build -o /stream ./cmd/scan/ \
        ;; \
    amd64) \
        CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
        go build -o /stream ./cmd/scan/ \
        ;; \
    esac


FROM --platform=$BUILDPLATFORM node:22-alpine AS web-builder

WORKDIR /app
COPY cmd/stream/app/package.json cmd/stream/app/package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY cmd/stream/app/ .
RUN npm run build


FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    bluez \
    libusb-1.0-0 \
    libftdi1-2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /mindlights
COPY --from=go-builder /stream ./stream
COPY --from=web-builder /app/build ./app

EXPOSE 30080

CMD ["./stream", "stream", "--config", "./config.yaml", "--host", "0.0.0.0", "--spa-path", "./app"]
